{
  "name": "mcp-demo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "bun run mcp-server/src/index.ts",
    "agent": "bun run agent/src/index.ts",
    "test": "bun test",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "check": "npm run lint && npm run format && tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run format",
      "tsc --noEmit"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0"
  }
}
